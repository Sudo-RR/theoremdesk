],"source":{"book":[],"pages":"717-721","series":[{"acronym":null,"issn":[{"number":"0143-0807","type":"print"}],"issue":"6","issue_id":111292,"parallel_title":null,"part":null,"publisher":"IOP Publishing, Bristol","series_id":78,"short_title":"Eur. J. Phys.","title":"European Journal of Physics","volume":"25","year":"2004"}],"source":"Eur. J. Phys. 25, No. 6, 717-721 (2004)."},"states":[["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Effective Hamiltonian and dynamic stability of the inverted pendulum"},"year":"2004","zbmath_url":"https://zbmath.org/2142583"},{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["henrard.jacques"],"name":"Henrard, J."},{"aliases":[],"checked":"1","codes":["lemaitre.anne"],"name":"Lemaitre, A."}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[],"id":3810977,"identifier":"0513.70012","keywords":["libration","circulation","resonance phenomena in celestial mechanics","Hamiltonian with several parameters","Enceladus-Dione resonance"],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[{"identifier":"10.1007/BF01234306","type":"doi","url":"https://doi.org/10.1007/BF01234306"}],"msc":[{"code":"70F15","scheme":"msc2020","text":"Celestial mechanics"},{"code":"70H05","scheme":"msc2020","text":"Hamilton's equations"}],"references":[{"doi":null,"position":"1","text":"Borderies, N.: 1980, ?La rotation de Mars: Théorie analytique, Analyse d'observations de l'expérience Viking?, Thesis, Univ. P. Sabatier (Toulouse).","zbmath":{"author_codes":[],"document_id":null,"msc":[],"prefix":null,"series_id":0,"year":null}},{"doi":"10.1086/111533","position":"2","text":"Colombo, G., Franklin, F. A., and Shapiro, I. I.: 1974,Astron. J. 79, 61.","zbmath":{"author_codes":[],"document_id":null,"msc":[],"prefix":null,"series_id":0,"year"