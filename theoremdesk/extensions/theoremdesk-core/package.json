{
	"name": "theoremdesk-core",
	"displayName": "TheoremDesk",
	"description": "Research projects, onboarding and research-friendly defaults for TheoremDesk.",
	"version": "0.1.0",
	"publisher": "theoremdesk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Sudo-RR/theoremdesk"
	},
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"*"
	],
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test \"test/**/*.test.js\""
	},
	"contributes": {
		"commands": [
			{
				"command": "theoremdesk.newResearchProject",
				"title": "New Research Project...",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.openGettingStarted",
				"title": "Get Started",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.checkEnvironment",
				"title": "Check Environment",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.environment.refresh",
				"title": "Check Again",
				"category": "TheoremDesk",
				"icon": "$(refresh)"
			},
			{
				"command": "theoremdesk.environment.fix",
				"title": "Fix",
				"category": "TheoremDesk",
				"icon": "$(wrench)"
			},
			{
				"command": "theoremdesk.leanBuild",
				"title": "Build Lean Project",
				"category": "TheoremDesk",
				"icon": "$(play)"
			},
			{
				"command": "theoremdesk.checkLeanKernel",
				"title": "Check with Lean Kernel (sandboxed)",
				"category": "TheoremDesk",
				"icon": "$(shield)"
			},
			{
				"command": "theoremdesk.verifyKernels",
				"title": "Verify with All Kernels (paranoid, slow)",
				"category": "TheoremDesk",
				"icon": "$(verified)"
			},
			{
				"command": "theoremdesk.checkProof",
				"title": "Check Proof Against Statement...",
				"category": "TheoremDesk",
				"icon": "$(git-compare)"
			},
			{
				"command": "theoremdesk.mutationTest",
				"title": "Mutation Test This File",
				"category": "TheoremDesk",
				"icon": "$(beaker)"
			},
			{
				"command": "theoremdesk.mutations.showDiff",
				"title": "Compare Mutant with File",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.repairToolchain",
				"title": "Repair Built-in Toolchain",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.newLatexDocument",
				"title": "New LaTeX Document from Template...",
				"category": "TheoremDesk",
				"icon": "$(new-file)"
			},
			{
				"command": "theoremdesk.setReferenceStyle",
				"title": "Reference Style for a Journal...",
				"category": "TheoremDesk",
				"icon": "$(book)"
			},
			{
				"command": "theoremdesk.literature.search",
				"title": "Search Literature...",
				"category": "TheoremDesk",
				"icon": "$(search)"
			},
			{
				"command": "theoremdesk.literature.recommend",
				"title": "Recommend Papers for This Project",
				"category": "TheoremDesk",
				"icon": "$(sparkle)"
			},
			{
				"command": "theoremdesk.literature.add",
				"title": "Add to Bibliography",
				"category": "TheoremDesk",
				"icon": "$(add)"
			},
			{
				"command": "theoremdesk.literature.copyCite",
				"title": "Copy cite{...}",
				"category": "TheoremDesk",
				"icon": "$(copy)"
			},
			{
				"command": "theoremdesk.literature.open",
				"title": "Open Paper",
				"category": "TheoremDesk",
				"icon": "$(link-external)"
			},
			{
				"command": "theoremdesk.literature.chooseSources",
				"title": "Choose Literature Sources...",
				"category": "TheoremDesk",
				"icon": "$(filter)"
			},
			{
				"command": "theoremdesk.ai.status",
				"title": "Local AI...",
				"category": "TheoremDesk",
				"icon": "$(hubot)"
			},
			{
				"command": "theoremdesk.ai.chooseModel",
				"title": "Choose the Local AI Model...",
				"category": "TheoremDesk",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "theoremdesk.ai.downloadModel",
				"title": "Download a Local AI Model...",
				"category": "TheoremDesk",
				"icon": "$(cloud-download)"
			},
			{
				"command": "theoremdesk.ai.stop",
				"title": "Stop the Local AI",
				"category": "TheoremDesk",
				"icon": "$(debug-stop)"
			},
			{
				"command": "theoremdesk.library.ask",
				"title": "Ask the Library...",
				"category": "TheoremDesk",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "theoremdesk.library.search",
				"title": "Search the Library...",
				"category": "TheoremDesk",
				"icon": "$(search)"
			},
			{
				"command": "theoremdesk.library.addBibliography",
				"title": "Add the Bibliography to the Library",
				"category": "TheoremDesk",
				"icon": "$(references)"
			},
			{
				"command": "theoremdesk.library.addPdf",
				"title": "Add PDFs to the Library...",
				"category": "TheoremDesk",
				"icon": "$(file-pdf)"
			},
			{
				"command": "theoremdesk.library.addPaper",
				"title": "Add to Library",
				"category": "TheoremDesk",
				"icon": "$(library)"
			},
			{
				"command": "theoremdesk.library.remove",
				"title": "Remove from Library",
				"category": "TheoremDesk",
				"icon": "$(trash)"
			},
			{
				"command": "theoremdesk.library.open",
				"title": "Open Paper",
				"category": "TheoremDesk",
				"icon": "$(link-external)"
			},
			{
				"command": "theoremdesk.agent.newChat",
				"title": "New Agent Chat",
				"category": "TheoremDesk",
				"icon": "$(add)"
			},
			{
				"command": "theoremdesk.agent.chooseModel",
				"title": "Choose the Agent Model...",
				"category": "TheoremDesk",
				"icon": "$(hubot)"
			},
			{
				"command": "theoremdesk.agent.openCodex",
				"title": "Open Codex (ChatGPT plan)",
				"category": "TheoremDesk",
				"icon": "$(terminal)"
			},
			{
				"command": "theoremdesk.agent.openClaudeCode",
				"title": "Open Claude Code (Claude plan)",
				"category": "TheoremDesk",
				"icon": "$(terminal)"
			},
			{
				"command": "theoremdesk.agent.ask",
				"title": "Ask the Agent...",
				"category": "TheoremDesk",
				"icon": "$(comment-discussion)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "theoremdesk",
					"title": "TheoremDesk",
					"icon": "media/theoremdesk.svg"
				}
			]
		},
		"views": {
			"theoremdesk": [
				{
					"id": "theoremdesk.environment",
					"name": "Environment"
				},
				{
					"id": "theoremdesk.verification",
					"name": "Verification"
				},
				{
					"id": "theoremdesk.mutations",
					"name": "Mutations"
				},
				{
					"id": "theoremdesk.literature",
					"name": "Literature"
				},
				{
					"id": "theoremdesk.library",
					"name": "Library"
				},
				{
					"type": "webview",
					"id": "theoremdesk.agent",
					"name": "Agent"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "theoremdesk.environment",
				"contents": "Checking Python, Lean and TeX..."
			},
			{
				"view": "theoremdesk.verification",
				"contents": "Check your Lean project with Lean's kernel, or with Lean's kernel and five independent checkers. A proof that exploits a bug in one kernel is caught by the others. Both run sandboxed and allow only the standard axioms.\n[Check with Lean Kernel](command:theoremdesk.checkLeanKernel)\n[Verify with All Kernels](command:theoremdesk.verifyKernels)\nCheck that a proof, such as one the research agent wrote, proves exactly the statement you wrote:\n[Check Proof Against Statement](command:theoremdesk.checkProof)\nThe Run button on Lean files offers all of these."
			},
			{
				"view": "theoremdesk.mutations",
				"contents": "Check that your Lean code verifies what you meant. TheoremDesk makes small changes (mutants) to the open file, then compiles each one:\n- a changed definition (cos → sin, + → -, 2 → 3) should make some theorem fail\n- a changed statement (a hypothesis dropped, < → ≤) should break its proof\nMutants that survive show where your theorems don't pin down what you intended.\n[Mutation Test This File](command:theoremdesk.mutationTest)"
			},
			{
				"view": "theoremdesk.literature",
				"contents": "Find papers on arXiv, INSPIRE-HEP, zbMATH Open, Crossref and OpenAlex, and add them to your bibliography in one click.\n[Recommend Papers for This Project](command:theoremdesk.literature.recommend)\n[Search Literature](command:theoremdesk.literature.search)\n[Choose Sources](command:theoremdesk.literature.chooseSources)"
			},
			{
				"view": "theoremdesk.library",
				"contents": "Your literature database, on this computer. Papers are read in full (their free PDF, else the abstract), so you can search them by meaning and ask questions answered with citations to the paper and page.\n[Add the Bibliography](command:theoremdesk.library.addBibliography)\n[Add PDFs](command:theoremdesk.library.addPdf)\nPapers you add to a .bib with + join the library automatically."
			}
		],
		"menus": {
			"file/newFile": [
				{
					"command": "theoremdesk.newResearchProject",
					"group": "file"
				},
				{
					"command": "theoremdesk.newLatexDocument",
					"group": "file"
				}
			],
			"view/title": [
				{
					"command": "theoremdesk.environment.refresh",
					"when": "view == theoremdesk.environment",
					"group": "navigation"
				},
				{
					"command": "theoremdesk.checkLeanKernel",
					"when": "view == theoremdesk.verification",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.verifyKernels",
					"when": "view == theoremdesk.verification",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.checkProof",
					"when": "view == theoremdesk.verification",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.mutationTest",
					"when": "view == theoremdesk.mutations",
					"group": "navigation"
				},
				{
					"command": "theoremdesk.literature.search",
					"when": "view == theoremdesk.literature",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.literature.recommend",
					"when": "view == theoremdesk.literature",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.literature.chooseSources",
					"when": "view == theoremdesk.literature",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.library.ask",
					"when": "view == theoremdesk.library",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.library.search",
					"when": "view == theoremdesk.library",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.library.addBibliography",
					"when": "view == theoremdesk.library",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.library.addPdf",
					"when": "view == theoremdesk.library",
					"group": "navigation@4"
				}
			],
			"view/item/context": [
				{
					"command": "theoremdesk.environment.fix",
					"when": "view == theoremdesk.environment && viewItem == fixable",
					"group": "inline"
				},
				{
					"command": "theoremdesk.literature.add",
					"when": "view == theoremdesk.literature && viewItem == paper",
					"group": "inline@1"
				},
				{
					"command": "theoremdesk.literature.copyCite",
					"when": "view == theoremdesk.literature && viewItem =~ /^paper/",
					"group": "inline@2"
				},
				{
					"command": "theoremdesk.literature.open",
					"when": "view == theoremdesk.literature && viewItem =~ /^paper/",
					"group": "inline@3"
				},
				{
					"command": "theoremdesk.literature.add",
					"when": "view == theoremdesk.literature && viewItem == paper",
					"group": "1_paper@1"
				},
				{
					"command": "theoremdesk.literature.copyCite",
					"when": "view == theoremdesk.literature && viewItem =~ /^paper/",
					"group": "1_paper@2"
				},
				{
					"command": "theoremdesk.literature.open",
					"when": "view == theoremdesk.literature && viewItem =~ /^paper/",
					"group": "1_paper@3"
				},
				{
					"command": "theoremdesk.library.addPaper",
					"when": "view == theoremdesk.literature && viewItem =~ /^paper/",
					"group": "1_paper@4"
				},
				{
					"command": "theoremdesk.library.remove",
					"when": "view == theoremdesk.library && viewItem == libraryPaper",
					"group": "inline"
				},
				{
					"command": "theoremdesk.library.remove",
					"when": "view == theoremdesk.library && viewItem == libraryPaper",
					"group": "1_paper@1"
				}
			],
			"commandPalette": [
				{
					"command": "theoremdesk.environment.fix",
					"when": "false"
				},
				{
					"command": "theoremdesk.mutations.showDiff",
					"when": "false"
				},
				{
					"command": "theoremdesk.literature.add",
					"when": "false"
				},
				{
					"command": "theoremdesk.literature.copyCite",
					"when": "false"
				},
				{
					"command": "theoremdesk.literature.open",
					"when": "false"
				},
				{
					"command": "theoremdesk.library.addPaper",
					"when": "false"
				},
				{
					"command": "theoremdesk.library.remove",
					"when": "false"
				},
				{
					"command": "theoremdesk.library.open",
					"when": "false"
				}
			],
			"editor/title/run": [
				{
					"command": "theoremdesk.leanBuild",
					"when": "resourceLangId == lean4",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.checkLeanKernel",
					"when": "resourceLangId == lean4",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.verifyKernels",
					"when": "resourceLangId == lean4",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.checkProof",
					"when": "resourceLangId == lean4",
					"group": "navigation@4"
				},
				{
					"command": "theoremdesk.mutationTest",
					"when": "resourceLangId == lean4",
					"group": "navigation@5"
				}
			],
			"editor/title": [
				{
					"command": "theoremdesk.setReferenceStyle",
					"when": "resourceLangId == latex",
					"group": "navigation@9"
				}
			]
		},
		"configurationDefaults": {
			"python.languageServer": "None",
			"workbench.colorTheme": "TheoremDesk Dark",
			"workbench.preferredDarkColorTheme": "TheoremDesk Dark",
			"workbench.preferredLightColorTheme": "TheoremDesk Light",
			"window.autoDetectColorScheme": true,
			"workbench.tips.enabled": false,
			"workbench.editor.empty.hint": "hidden",
			"workbench.layoutControl.enabled": false,
			"editor.minimap.enabled": false,
			"editor.unicodeHighlight.ambiguousCharacters": false,
			"editor.fontFamily": "'JuliaMono', 'Cascadia Code', Consolas, 'DejaVu Sans Mono', monospace"
		},
		"walkthroughs": [
			{
				"id": "gettingStarted",
				"title": "Get started with TheoremDesk",
				"description": "Create a research project, then set up Python, Lean and LaTeX for it.",
				"steps": [
					{
						"id": "newProject",
						"title": "Create a research project",
						"description": "Start from the Hamiltonian mechanics reference project: SymPy and SciPy notebooks, a Lean project on Physlib, and a LaTeX manuscript that includes the notebooks' results.\n[New Research Project](command:theoremdesk.newResearchProject)",
						"media": {
							"markdown": "media/walkthrough/new-project.md"
						},
						"completionEvents": [
							"onCommand:theoremdesk.newResearchProject"
						]
					},
					{
						"id": "environment",
						"title": "Check your environment",
						"description": "TheoremDesk checks Git, Python, Lean, Mathlib and TeX for you, and installs or fixes what's missing with one click.\n[Check Environment](command:theoremdesk.checkEnvironment)",
						"media": {
							"markdown": "media/walkthrough/environment.md"
						},
						"completionEvents": [
							"onCommand:theoremdesk.checkEnvironment"
						]
					},
					{
						"id": "python",
						"title": "Set up Python",
						"description": "Create a virtual environment for the project and install its requirements.txt.\n[Create Environment](command:python.createEnvironment)",
						"media": {
							"markdown": "media/walkthrough/python.md"
						},
						"completionEvents": [
							"onCommand:python.createEnvironment"
						]
					},
					{
						"id": "lean",
						"title": "Install Lean",
						"description": "Install elan, Lean's version manager. Each project pins the Lean version its libraries need.\n[Install Lean](command:lean4.setup.installElan)\n[Open the Lean setup guide](command:lean4.docs.showSetupGuide)",
						"media": {
							"markdown": "media/walkthrough/lean.md"
						},
						"completionEvents": [
							"onCommand:lean4.setup.installElan",
							"onCommand:lean4.docs.showSetupGuide"
						]
					},
					{
						"id": "latexTemplates",
						"title": "Start a paper, thesis or talk",
						"description": "22 ready-to-compile templates: APS, AMS, Elsevier, MNRAS, IEEE, ACM, Springer LNCS, Beamer, posters, and theses for MIT, Berkeley, Toronto, Edinburgh and more. Everything they need is built in.\n[New LaTeX Document](command:theoremdesk.newLatexDocument)\nAlready writing? Set the reference style your journal expects.\n[Reference Style for a Journal](command:theoremdesk.setReferenceStyle)",
						"media": {
							"markdown": "media/walkthrough/latex-templates.md"
						},
						"completionEvents": [
							"onCommand:theoremdesk.newLatexDocument"
						]
					},
					{
						"id": "latex",
						"title": "Install a TeX distribution",
						"description": "The manuscript needs a TeX distribution such as MiKTeX or TeX Live. Once one is installed, open manuscript/main.tex and build it.\n[Build Manuscript](command:latex-workshop.build)",
						"media": {
							"markdown": "media/walkthrough/latex.md"
						},
						"completionEvents": [
							"onCommand:latex-workshop.build"
						]
					}
				]
			}
		],
		"themes": [
			{
				"label": "TheoremDesk Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/theoremdesk-dark.json"
			},
			{
				"label": "TheoremDesk Light",
				"uiTheme": "vs",
				"path": "./themes/theoremdesk-light.json"
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "theoremdesk.literature",
				"label": "TheoremDesk Literature (arXiv)"
			}
		],
		"configuration": {
			"title": "TheoremDesk",
			"properties": {
				"theoremdesk.literature.sources": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": [
							"arxiv",
							"inspire",
							"zbmath",
							"crossref",
							"openalex"
						],
						"enumDescriptions": [
							"arXiv preprints (physics, mathematics, CS)",
							"INSPIRE-HEP: high-energy physics, with INSPIRE citation keys",
							"zbMATH Open: mathematics, with reviews and MSC classes",
							"Crossref: published journal articles with DOIs",
							"OpenAlex: all fields; also finds works related to those you cite"
						]
					},
					"default": [
						"arxiv",
						"inspire",
						"zbmath",
						"crossref",
						"openalex"
					],
					"markdownDescription": "Where Literature search and recommendations look. Results from several sources are merged: a paper appears once, with its arXiv abstract, its journal details and its INSPIRE key."
				},
				"theoremdesk.ai.localModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "The local model the agent uses: empty for the built-in Qwen3.5-9B, or the file name of a downloaded model (see **TheoremDesk: Choose the Local AI Model**)."
				},
				"theoremdesk.ai.contextTokens": {
					"type": "number",
					"default": 32768,
					"minimum": 4096,
					"markdownDescription": "How much text (in tokens) the local agent model can take in at once. Larger needs more memory."
				},
				"theoremdesk.ai.useGpu": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Run the local models on the GPU when there is one (NVIDIA, AMD or Intel, through Vulkan). They fall back to the CPU otherwise."
				},
				"theoremdesk.ai.idleMinutes": {
					"type": "number",
					"default": 15,
					"minimum": 0,
					"markdownDescription": "Stop a local model after this many minutes unused, to free its memory (0: never). It starts again when needed."
				},
				"theoremdesk.library.addCitedPapers": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "When you add a paper to a `.bib` from the Literature view, also read it into the library (its free PDF, else its abstract)."
				},
				"theoremdesk.agent.provider": {
					"type": "string",
					"enum": [
						"local",
						"openai",
						"anthropic",
						"custom"
					],
					"default": "local",
					"markdownDescription": "Where the agent model runs: TheoremDesk Local (offline), or a provider API with your key."
				},
				"theoremdesk.agent.model": {
					"type": "string",
					"default": "",
					"markdownDescription": "The model ID for an API provider."
				},
				"theoremdesk.agent.baseUrl": {
					"type": "string",
					"default": "",
					"markdownDescription": "The address of an OpenAI-compatible API (for the `custom` provider)."
				},
				"theoremdesk.agent.thinking": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Let the local model reason step by step before answering: better on hard problems, much slower on a laptop."
				},
				"theoremdesk.agent.maxSteps": {
					"type": "number",
					"default": 12,
					"minimum": 1,
					"markdownDescription": "The most model calls the agent makes for one message."
				}
			}
		}
