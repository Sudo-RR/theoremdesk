{
	"name": "theoremdesk-core",
	"displayName": "TheoremDesk",
	"description": "Research projects, onboarding and research-friendly defaults for TheoremDesk.",
	"version": "0.1.0",
	"publisher": "theoremdesk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Sudo-RR/theoremdesk"
	},
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test \"test/**/*.test.js\""
	},
	"contributes": {
		"commands": [
			{
				"command": "theoremdesk.newResearchProject",
				"title": "New Research Project...",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.openGettingStarted",
				"title": "Get Started",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.checkEnvironment",
				"title": "Check Environment",
				"category": "TheoremDesk"
			},
			{
				"command": "theoremdesk.environment.refresh",
				"title": "Check Again",
				"category": "TheoremDesk",
				"icon": "$(refresh)"
			},
			{
				"command": "theoremdesk.environment.fix",
				"title": "Fix",
				"category": "TheoremDesk",
				"icon": "$(wrench)"
			},
			{
				"command": "theoremdesk.leanBuild",
				"title": "Build Lean Project",
				"category": "TheoremDesk",
				"icon": "$(play)"
			},
			{
				"command": "theoremdesk.checkLeanKernel",
				"title": "Check with Lean Kernel (sandboxed)",
				"category": "TheoremDesk",
				"icon": "$(shield)"
			},
			{
				"command": "theoremdesk.verifyKernels",
				"title": "Verify with All Kernels (paranoid, slow)",
				"category": "TheoremDesk",
				"icon": "$(verified)"
			},
			{
				"command": "theoremdesk.checkProof",
				"title": "Check Proof Against Statement...",
				"category": "TheoremDesk",
				"icon": "$(git-compare)"
			},
			{
				"command": "theoremdesk.mutationTest",
				"title": "Mutation Test This File",
				"category": "TheoremDesk",
				"icon": "$(beaker)"
			},
			{
				"command": "theoremdesk.mutations.showDiff",
				"title": "Compare Mutant with File",
				"category": "TheoremDesk"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "theoremdesk",
					"title": "TheoremDesk",
					"icon": "media/theoremdesk.svg"
				}
			]
		},
		"views": {
			"theoremdesk": [
				{
					"id": "theoremdesk.environment",
					"name": "Environment"
				},
				{
					"id": "theoremdesk.verification",
					"name": "Verification"
				},
				{
					"id": "theoremdesk.mutations",
					"name": "Mutations"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "theoremdesk.environment",
				"contents": "Checking Python, Lean and TeX..."
			},
			{
				"view": "theoremdesk.verification",
				"contents": "Check your Lean project with Lean's kernel, or with Lean's kernel and five independent checkers. A proof that exploits a bug in one kernel is caught by the others. Both run sandboxed and allow only the standard axioms.\n[Check with Lean Kernel](command:theoremdesk.checkLeanKernel)\n[Verify with All Kernels](command:theoremdesk.verifyKernels)\nCheck that a proof, such as one the research agent wrote, proves exactly the statement you wrote:\n[Check Proof Against Statement](command:theoremdesk.checkProof)\nThe Run button on Lean files offers all of these."
			},
			{
				"view": "theoremdesk.mutations",
				"contents": "Check that your Lean code verifies what you meant. TheoremDesk makes small changes (mutants) to the open file, then compiles each one:\n- a changed definition (cos → sin, + → -, 2 → 3) should make some theorem fail\n- a changed statement (a hypothesis dropped, < → ≤) should break its proof\nMutants that survive show where your theorems don't pin down what you intended.\n[Mutation Test This File](command:theoremdesk.mutationTest)"
			}
		],
		"menus": {
			"file/newFile": [
				{
					"command": "theoremdesk.newResearchProject",
					"group": "file"
				}
			],
			"view/title": [
				{
					"command": "theoremdesk.environment.refresh",
					"when": "view == theoremdesk.environment",
					"group": "navigation"
				},
				{
					"command": "theoremdesk.checkLeanKernel",
					"when": "view == theoremdesk.verification",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.verifyKernels",
					"when": "view == theoremdesk.verification",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.checkProof",
					"when": "view == theoremdesk.verification",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.mutationTest",
					"when": "view == theoremdesk.mutations",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "theoremdesk.environment.fix",
					"when": "view == theoremdesk.environment && viewItem == fixable",
					"group": "inline"
				}
			],
			"commandPalette": [
				{
					"command": "theoremdesk.environment.fix",
					"when": "false"
				},
				{
					"command": "theoremdesk.mutations.showDiff",
					"when": "false"
				}
			],
			"editor/title/run": [
				{
					"command": "theoremdesk.leanBuild",
					"when": "resourceLangId == lean4",
					"group": "navigation@1"
				},
				{
					"command": "theoremdesk.checkLeanKernel",
					"when": "resourceLangId == lean4",
					"group": "navigation@2"
				},
				{
					"command": "theoremdesk.verifyKernels",
					"when": "resourceLangId == lean4",
					"group": "navigation@3"
				},
				{
					"command": "theoremdesk.checkProof",
					"when": "resourceLangId == lean4",
					"group": "navigation@4"
				},
				{
					"command": "theoremdesk.mutationTest",
					"when": "resourceLangId == lean4",
					"group": "navigation@5"
				}
			]
		},
		"configurationDefaults": {
			"python.languageServer": "None"
		},
		"walkthroughs": [
			{
				"id": "gettingStarted",
				"title": "Get started with TheoremDesk",
				"description": "Create a research project, then set up Python, Lean and LaTeX for it.",
				"steps": [
					{
						"id": "newProject",
						"title": "Create a research project",
						"description": "Start from the Hamiltonian mechanics reference project: SymPy and SciPy notebooks, a Lean project on Physlib, and a LaTeX manuscript that includes the notebooks' results.\n[New Research Project](command:theoremdesk.newResearchProject)",
						"media": {
							"markdown": "media/walkthrough/new-project.md"
						},
						"completionEvents": [
							"onCommand:theoremdesk.newResearchProject"
						]
					},
					{
						"id": "environment",
						"title": "Check your environment",
						"description": "TheoremDesk checks Git, Python, Lean, Mathlib and TeX for you, and installs or fixes what's missing with one click.\n[Check Environment](command:theoremdesk.checkEnvironment)",
						"media": {
							"markdown": "media/walkthrough/environment.md"
						},
						"completionEvents": [
							"onCommand:theoremdesk.checkEnvironment"
						]
					},
					{
						"id": "python",
						"title": "Set up Python",
						"description": "Create a virtual environment for the project and install its requirements.txt.\n[Create Environment](command:python.createEnvironment)",
						"media": {
							"markdown": "media/walkthrough/python.md"
						},
						"completionEvents": [
							"onCommand:python.createEnvironment"
						]
					},
					{
						"id": "lean",
						"title": "Install Lean",
						"description": "Install elan, Lean's version manager. Each project pins the Lean version its libraries need.\n[Install Lean](command:lean4.setup.installElan)\n[Open the Lean setup guide](command:lean4.docs.showSetupGuide)",
						"media": {
							"markdown": "media/walkthrough/lean.md"
						},
						"completionEvents": [
							"onCommand:lean4.setup.installElan",
							"onCommand:lean4.docs.showSetupGuide"
						]
					},
					{
						"id": "latex",
						"title": "Install a TeX distribution",
						"description": "The manuscript needs a TeX distribution such as MiKTeX or TeX Live. Once one is installed, open manuscript/main.tex and build it.\n[Build Manuscript](command:latex-workshop.build)",
						"media": {
							"markdown": "media/walkthrough/latex.md"
						},
						"completionEvents": [
							"onCommand:latex-workshop.build"
						]
					}
				]
			}
		]
	},
	"devDependencies": {
		"@types/node": "^24.19.4",
		"@types/vscode": "~1.95.0",
		"typescript": "~5.9.3"
	}
}
